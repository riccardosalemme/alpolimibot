          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n    ((g.data + s.inizio) AT TIME ZONE 'Europe/Rome') AS \"time\",\n    ((g.data + s.fine) AT TIME ZONE 'Europe/Rome') AS \"time_end\",\n    COALESCE(s.corso, 'Occupato') AS \"Stato / Corso\"\nFROM occupazione_giorno g\nJOIN occupazione_slot s ON g.id = s.id_giorno\nWHERE g.idaula = '$aula'::integer\n  AND $__timeFilter((g.data + s.inizio)::timestamp)\nORDER BY s.inizio ASC;",
