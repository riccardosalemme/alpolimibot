          "rawSql": "SELECT \n    TO_CHAR(g.data, 'DD/MM/YYYY') AS \"Data\",\n    TO_CHAR(s.inizio, 'HH24:MI') AS \"Ora Inizio\",\n    TO_CHAR(s.fine, 'HH24:MI') AS \"Ora Fine\",\n    COALESCE(s.corso, 'Occupato') AS \"Corso / Occupazione\"\nFROM occupazione_giorno g\nJOIN occupazione_slot s ON g.id = s.id_giorno\nWHERE g.idaula = '$aula'::integer\n  AND $__timeFilter((g.data + s.inizio)::timestamp)\nORDER BY g.data DESC, s.inizio ASC;",
