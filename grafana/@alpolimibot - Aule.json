        {
          "dataset": "flights",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POLIMI-AULE-BOT}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n    a.idaula                                            AS \"ID\",\n    a.sigla                                             AS \"Sigla\",\n    TO_CHAR(MIN(og.data), 'DD/MM/YYYY')                 AS \"Primo giorno in archivio\",\n    TO_CHAR(MAX(og.data), 'DD/MM/YYYY')                 AS \"Ultimo giorno in archivio\",\n    TO_CHAR(MAX(og.scaricato_il), 'DD/MM/YYYY')         AS \"Data ultimo aggiornamento\",\n    COUNT(DISTINCT og.data)                             AS \"Numero giorni in archivio\" \n    \nFROM aula a\nLEFT JOIN occupazione_giorno og ON og.idaula = a.idaula\nLEFT JOIN edificio e  ON e.csie  = a.csie\nLEFT JOIN campus   ca ON ca.csic = e.csic\nGROUP BY a.idaula, a.sigla, ca.nome\nORDER BY sigla",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
