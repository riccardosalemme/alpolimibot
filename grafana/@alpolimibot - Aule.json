          "rawQuery": true,
          "rawSql": "SELECT\n    a.idaula AS \"ID\",\n    a.sigla AS \"Sigla\",\n    a.capienza AS \"Capienza\",\n    s.nome  AS \"Sede\"\nFROM aula a\nJOIN aula_dotazione  ad ON ad.idaula           = a.idaula\nJOIN tipo_dotazione  td ON td.id               = ad.id_tipo_dotazione\nLEFT JOIN edificio e  ON e.csie  = a.csie\nLEFT JOIN campus   ca ON ca.csic = e.csic\nLEFT JOIN sede     s  ON s.csis  = ca.csis\nWHERE td.id = 142\nORDER BY a.sigla;",
